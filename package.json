{
  "name": "spotify-carthing-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Custom Car Thing (Nocturne) dashboard showing Claude Code sessions + calendar, fed from the Mac.",
  "scripts": {
    "feeder": "bun run server/src/index.ts",
    "feeder:dev": "bun --watch run server/src/index.ts",
    "ui": "cd dashboard && VITE_WS_URL=ws://localhost:4000/ws bun run dev",
    "build": "cd dashboard && bun run build",
    "ui:build": "bun run build",
    "preview": "bun run build && bun run feeder",
    "deploy": "bun run build && bun run device:reload",
    "device:connect": "bun run scripts/connect.ts",
    "daemon:install": "bash scripts/install-daemon.sh",
    "daemon:uninstall": "bash scripts/uninstall-daemon.sh",
    "daemon:logs": "tail -f ~/.carthing-com.carthing.feeder.log ~/.carthing-com.carthing.tunnel.log",
    "device:reload": "bun run scripts/device.ts reload",
    "device:shot": "bun run scripts/device.ts shot",
    "device:open": "bun run scripts/device.ts open",
    "device:info": "bun run scripts/device.ts info",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0"
  }
}
