{
  "name": "commandthing-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "CommandThing turns a Spotify Car Thing into a personal desktop command center.",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @commandthing/feeder --filter @commandthing/dashboard run dev",
    "feeder": "pnpm --filter @commandthing/feeder start",
    "feeder:dev": "pnpm --filter @commandthing/feeder dev",
    "ui": "pnpm --filter @commandthing/dashboard dev",
    "build": "pnpm --filter @commandthing/dashboard build",
    "ui:build": "pnpm build",
    "preview": "pnpm build && pnpm feeder",
    "deploy": "pnpm build && pnpm device:reload",
    "commandthing": "node packages/cli/bin/commandthing.js",
    "hooks:setup": "pnpm commandthing setup hooks",
    "typecheck": "pnpm --filter @commandthing/dashboard --filter @commandthing/feeder run typecheck",
    "test": "pnpm --filter commandthing test",
    "device:connect": "bun run scripts/connect.ts",
    "daemon:install": "bash scripts/install-daemon.sh",
    "daemon:uninstall": "bash scripts/uninstall-daemon.sh",
    "daemon:logs": "tail -f ~/.commandthing-com.commandthing.feeder.log ~/.commandthing-com.commandthing.tunnel.log",
    "device:reload": "bun run scripts/device.ts reload",
    "device:shot": "bun run scripts/device.ts shot",
    "device:open": "bun run scripts/device.ts open",
    "device:info": "bun run scripts/device.ts info",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0"
  }
}
