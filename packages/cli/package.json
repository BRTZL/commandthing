{
  "name": "commandthing",
  "version": "0.1.0",
  "type": "module",
  "description": "Set up and manage CommandThing for Spotify Car Thing devices.",
  "bin": {
    "commandthing": "./bin/commandthing.js"
  },
  "files": [
    "bin",
    "src/*.js",
    "templates",
    "runtime",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/commandthing.js",
    "check": "node --check bin/commandthing.js && node --check src/commands.js && node --check src/locations.js && node --check src/services.js && node --check templates/commandthing-hook.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepack": "node build/build-runtime.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.6",
    "typescript": "^5.6.3",
    "ws": "^8.18.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BRTZL/commandthing.git"
  },
  "homepage": "https://github.com/BRTZL/commandthing#readme",
  "bugs": "https://github.com/BRTZL/commandthing/issues",
  "keywords": [
    "car-thing",
    "command-center",
    "nocturne",
    "spotify",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public"
  }
}
