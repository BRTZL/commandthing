# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor — keep shared config, ignore everything else under .vscode
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# No project env file is required. Ignore any accidental local env files as a secrets safeguard.
.env
.env.*
!.env.example

# Screenshots / scratch artifacts
apps/dashboard/*.png
device-shot.png
*-shot.png

# launchd daemon logs
.carthing-*.log
.commandthing-*.log

# device crash dumps + diagnostic screenshots
device-crashes*/
device-*.png
